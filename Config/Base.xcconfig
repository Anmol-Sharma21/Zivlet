// Shared by all configurations (04 §3.2).
MACOSX_DEPLOYMENT_TARGET = 26.0
ARCHS = arm64
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
GENERATE_INFOPLIST_FILE = NO
MARKETING_VERSION = 0.0.1
CURRENT_PROJECT_VERSION = 1
// Every Xcode build here is ad-hoc (above), and library validation refuses the ad-hoc Sparkle.framework in an ad-hoc
// app ("different Team IDs"). Xcode writes this exception into the signed entitlements; a Developer ID build is
// re-signed by Scripts/sign-app.sh with Config/Zivlet.entitlements, which keeps library validation on.
RUNTIME_EXCEPTION_DISABLE_LIBRARY_VALIDATION = YES
